<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.hexaphone.performance"
    android:sharedUserId="android.uid.system">

    <!--
      Runs as the system UID so it can call SystemProperties.set() on the
      persist.sys.hexaphone.* properties (see res/xml + sepolicy notes).
      The actual privileged sysfs/swapon work happens in a root init
      script (vendor/hexaphone/bin/hexaphone-zram.sh) triggered by those
      property changes — this app never touches /sys or swapon directly.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:persistent="false">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
