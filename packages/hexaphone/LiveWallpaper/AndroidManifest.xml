<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.hexaphone.livewallpaper"
    android:sharedUserId="android.uid.system">

    <!--
      Same UID as System Tweaks and Bootscreen (already
      sharedUserId=android.uid.system) purely so System Tweaks' backup
      tool can read this app's color preference via createPackageContext;
      same-UID apps can access each other's SharedPreferences, cross-
      package data access is otherwise sandboxed. Nothing else here needs
      the elevated UID.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher">

        <service
            android:name=".HexSpinWallpaperService"
            android:label="@string/wallpaper_name"
            android:icon="@drawable/thumbnail"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <activity
            android:name=".ColorSettingsActivity"
            android:label="@string/settings_title"
            android:exported="true" />

    </application>
</manifest>
