# Hexaphone ZRAM/swap configuration.
#
# The Performance app only ever writes persist.sys.hexaphone.* properties
# (see packages/hexaphone/Performance) — it has no root access. This
# service applies that configuration at boot, running as root.
#
# Deliberately boot-time-only rather than live/hot-reconfigurable: zram
# requires swapoff + reset before disksize/algorithm can change, and doing
# that while the system is actively relying on existing zram swap risks
# killing foreground apps under memory pressure. Simpler and safer to just
# apply once at boot and tell the user changes need a reboot (see
# res/values/strings.xml reboot_notice in the app).

service hexaphone_zram /system/bin/hexaphone-zram.sh boot
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:hexaphone_zram:s0

on post-fs-data
    start hexaphone_zram
    # Bootscreen app (packages/hexaphone/Bootscreen) writes hash-verified
    # bootanimation.zip presets here as bootanimation.zip (see
    # scripts/patch-bootanimation.sh, which makes bootanimation itself
    # check this path directly -- no root "apply" step needed at all).
    # system:system owner so the app (sharedUserId=android.uid.system)
    # can write directly; mode 0755 (not 0770) since bootanimation runs
    # as user/group graphics, not system -- DAC and SELinux are both
    # independently enforced, so this needs to be world-readable on top
    # of the SELinux grant in hexaphone.te.
    mkdir /data/hexaphone_bootscreen 0755 system system
    # init's mkdir builtin (system/core/init/builtins.cpp do_mkdir) only
    # ever sets DAC mode/owner -- it does NOT apply the SELinux label
    # from vendor/hexaphone/sepolicy/file_contexts the way it might look
    # like it should. Without this explicit restorecon, the directory
    # silently inherits /data's own type (system_data_file) instead of
    # hexaphone_bootscreen_data_file, so bootanim's `allow` grant in
    # hexaphone.te never matches anything real on disk and every preset
    # silently fails to apply at boot -- the write from Bootscreen (as
    # system_app, which system_data_file already exempts from the
    # no-write neverallow) succeeds either way, which is exactly why this
    # was invisible from the app side. Found this by re-reading do_mkdir's
    # actual source after a preset didn't apply on a real boot.
    restorecon --recursive /data/hexaphone_bootscreen

# SELinux permissive toggle (System Tweaks app + its QS tile). A plain
# sys.* property, not persist.* -- this represents a one-shot command
# ("apply this value now"), not state to reapply at every boot, and
# setenforce 0 itself already only lasts until the next reboot
# regardless of whether anything ever sets it back to enforcing first.
service hexaphone_selinux_permissive /system/bin/hexaphone-selinux-permissive.sh
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:hexaphone_selinux_permissive:s0

# Fires on *every* value change (not just =1) -- the script itself reads
# the property back to decide permissive vs enforcing, so this just needs
# to notice something changed.
on property:sys.hexaphone.selinux_permissive=*
    start hexaphone_selinux_permissive
