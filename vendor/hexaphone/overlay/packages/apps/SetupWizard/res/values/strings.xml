<?xml version="1.0" encoding="utf-8"?>
<!--
     Rebrands SetupWizard from LineageOS to Hexaphone. Most of the app's
     copy already substitutes %s from os_name at runtime, so overriding
     that one string covers it; these three are the only strings that
     hardcode "LineageOS" as plain text instead.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="os_name" translatable="false">Hexaphone</string>

    <string name="setup_services">Hexaphone features</string>
    <string name="services_explanation" product="tablet">These services work for you to extend the capabilities of your tablet. Data will be used in accordance with Hexaphone\'s <xliff:g id="name" example="Privacy Policy">%s</xliff:g>.</string>
    <string name="services_explanation" product="default">These services work for you to extend the capabilities of your phone. Data will be used in accordance with Hexaphone\'s <xliff:g id="name" example="Privacy Policy">%s</xliff:g>.</string>
</resources>
